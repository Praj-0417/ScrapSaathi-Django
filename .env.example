# ==============================================================================
# ScrapSaathi Django Backend Environment Configuration Template
# Copy this file to .env and populate with your environment secrets
# ==============================================================================

# ─── 1. Application & Runtime ────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=generate-a-secure-50-character-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver,.onrender.com,.vercel.app
PORT=8000

# ─── 2. CORS & Client Origins ────────────────────────────────────────────────
# Comma-separated allowed frontend domains (React on Vercel, Render, local dev)
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,https://scrap-sathi.vercel.app,https://scrap-sathi-lyart.vercel.app
CORS_ALLOW_ALL_ORIGINS=True

# Frontend live URL for email verification and notification redirects
FRONTEND_URL=https://scrap-sathi-lyart.vercel.app

# ─── 3. Database Configuration ───────────────────────────────────────────────
# Option A: Cloud PaaS single connection string (Render/Railway/Neon/Supabase)
# DATABASE_URL=postgresql://scrapsaathi_user:password@host:5432/scrapsaathi_db
DATABASE_URL=

# Option B: Individual PostgreSQL connection parameters
DB_ENGINE=postgresql
USE_SQLITE=False
POSTGRES_DB=scrapsaathi_db
POSTGRES_USER=scrapsaathi_user
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ─── 4. Authentication, JWT & Security ───────────────────────────────────────
JWT_SECRET=supersecret-scrapsaathi-jwt-secret-key-nk-securities
JWT_EXPIRES_IN=86400
BCRYPT_ROUNDS=12
OTP_EXPIRATION_SECONDS=600

# ─── 5. Google OAuth 2.0 ─────────────────────────────────────────────────────
# Matches VITE_GOOGLE_CLIENT_ID from the React frontend
GOOGLE_CLIENT_ID=89870125852-ljoj152666esp5je2dhkavk2gjd19aff.apps.googleusercontent.com

# ─── 6. Email & SMTP Configuration (OTP, Notifications) ──────────────────────
# Leave password blank to use Console backend (prints OTPs to terminal) in dev
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM_NAME=ScrapSaathi
PRIMARY_EMAIL=
PRIMARY_EMAIL_PASSWORD=
FALLBACK_EMAIL=
FALLBACK_EMAIL_PASSWORD=

# ─── 7. Cloudinary (Pickup Photo & File Uploads) ──────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── 8. API Rate Limiting ────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
OTP_RATE_LIMIT_MAX=5

# ─── 9. Default Administrator Seed Credentials ──────────────────────────────
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@scrapsaathi.com
ADMIN_PASSWORD=Admin@123456
ADMIN_PHONE=9876543210

# ─── 10. Observability & Monitoring ──────────────────────────────────────────
PROMETHEUS_METRICS_ENABLED=True
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
